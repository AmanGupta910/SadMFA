# =============================================================================
# GoCart MFA - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
# NEVER commit the real ".env" file - it is listed in .gitignore.
# =============================================================================

# ---------- Server ----------
PORT=3000
NODE_ENV=development
# Base URL used to build the "YES, IT'S ME" link inside the verification email.
APP_BASE_URL=http://localhost:3000

# ---------- Secrets ----------
# Signs the session cookie. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Extra server-side secret ("pepper") mixed into OTP / token hashes.
# A stolen database alone is then not enough to verify a stolen hash.
HASH_PEPPER=replace-with-another-long-random-string

# ---------- MFA policy ----------
BCRYPT_ROUNDS=12
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
EMAIL_TOKEN_TTL_MINUTES=15
EMAIL_RESEND_COOLDOWN_SECONDS=60
MFA_SESSION_TTL_MINUTES=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------- Email deliverability ----------
# true = refuse registration when the email domain publishes no mail server
#        (blocks example.com, typos like gmial.com, and throw-away inboxes).
# Set to false only if you must demo on a machine with no internet.
VERIFY_EMAIL_MX=true
MX_LOOKUP_TIMEOUT_MS=5000

# ---------- Email delivery (SMTP) ----------
# smtp    = really send the OTP and the "YES, IT'S ME" link by email. USE THIS.
# console = do not send anything; write the message to data/outbox/ instead.
#           Offline fallback only - the user never receives a real email.
#
# Do NOT fill these in by hand. Run this instead, which types the password
# hidden and writes the values here for you:
#
#     npm run setup-email
#
MAIL_TRANSPORT=smtp

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-address@gmail.com
# Gmail: this must be a 16-character APP PASSWORD, not your login password.
#        Create one at myaccount.google.com/apppasswords (needs 2-Step Verification).
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="GoCart Security <your-address@gmail.com>"

# ---------- Demo mode ----------
# false = normal, secure behaviour. The OTP and the verification link exist
#         ONLY inside the email. This is what you want for the demo.
# true  = also print the OTP and link on screen. Offline fallback only.
#         Forced OFF whenever NODE_ENV=production.
DEMO_MODE=false

# ---------- Deployment only ----------
# Leave these alone for local development.
#
# DATA_DIR   where the SQLite file is written. Point it at a mounted
#            persistent disk in production (e.g. /var/data on Render),
#            otherwise every account is lost when the container restarts.
# DATA_DIR=/var/data
#
# In production you MUST also set:
#   NODE_ENV=production
#   APP_BASE_URL=https://your-app.onrender.com   (the real public https URL -
#                the "YES, IT'S ME" email link is built from this value)
# The server refuses to start in production if APP_BASE_URL is still localhost
# or is not https, because the verification email would be unusable.
